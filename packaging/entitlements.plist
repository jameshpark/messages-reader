<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one-file bootloader unpacks and loads its own ad-hoc-signed Python
	     library, which has no Team ID; everything else hardened runtime
	     blocks (DYLD_* injection, debugger attach) stays blocked. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
